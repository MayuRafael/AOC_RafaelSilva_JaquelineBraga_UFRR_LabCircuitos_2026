    <comp lib="9" loc="(1680,40)" name="Text"><a name="color" val="#0000a0"/><a name="font" val="SansSerif bold 13"/><a name="halign" val="left"/><a name="text" val="LEGENDA: MEMORIA_PARTE1_FIOS = (versao so com fios) Modulo de memoria de 64 bytes"/></comp>
    <comp lib="9" loc="(1680,60)" name="Text"><a name="color" val="#0000a0"/><a name="halign" val="left"/><a name="text" val="A5 A4 = escolhem o dispositivo: 00=ROM, 01=RAM, 10=Banco de registradores, 11=E/S"/></comp>
    <comp lib="9" loc="(1680,80)" name="Text"><a name="color" val="#0000a0"/><a name="halign" val="left"/><a name="text" val="END = endereco dentro do dispositivo (A3..A0, 4 bits)"/></comp>
    <comp lib="9" loc="(1680,100)" name="Text"><a name="color" val="#0000a0"/><a name="halign" val="left"/><a name="text" val="ENTRADA = dado de 8 bits a ser gravado"/></comp>
    <comp lib="9" loc="(1680,120)" name="Text"><a name="color" val="#0000a0"/><a name="halign" val="left"/><a name="text" val="ESCREVER = 1 para gravar"/></comp>
    <comp lib="9" loc="(1680,140)" name="Text"><a name="color" val="#0000a0"/><a name="halign" val="left"/><a name="text" val="RELOGIO = grava na subida (0-&gt;1)"/></comp>
    <comp lib="9" loc="(1680,160)" name="Text"><a name="color" val="#0000a0"/><a name="halign" val="left"/><a name="text" val="ZERAR = zera os registradores"/></comp>
    <comp lib="9" loc="(1680,180)" name="Text"><a name="color" val="#0000a0"/><a name="halign" val="left"/><a name="text" val="SAIDA = dado lido (8 bits)"/></comp>
    <comp lib="9" loc="(1680,200)" name="Text"><a name="color" val="#0000a0"/><a name="halign" val="left"/><a name="text" val="ERRO = 1 se a paridade falhou (LED)"/></comp>
    <comp lib="9" loc="(1680,220)" name="Text"><a name="color" val="#0000a0"/><a name="halign" val="left"/><a name="text" val="MUX4_8 = escolhe qual dispositivo vai para SAIDA (seletor = A5 A4)"/></comp>
    <comp lib="9" loc="(1680,240)" name="Text"><a name="color" val="#0000a0"/><a name="halign" val="left"/><a name="text" val="CS = Chip Select: habilita so o dispositivo escolhido"/></comp>
